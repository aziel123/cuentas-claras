<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>
	<groupId>pe.edu.virgenmaria</groupId>
	<artifactId>cuentas-claras</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<name>cuentas-claras</name>
	<description>Plataforma de gestión escolar con cobranza antifraude para el Colegio Virgen María</description>

	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<poi.version>5.5.1</poi.version>
		<!-- Sprint 7, tanda 3 (A06, decisión 102): OSV-Scanner encontró vulnerabilidades con arreglo en las versiones que
		     trae Spring Boot 4.1.1 (no hay 4.1.2 publicado). Se suben solo los parches de la misma línea:
		     - Tomcat 11.0.24 → 11.0.26: CVE-2026-65905, CVE-2026-65182 y CVE-2026-68525 (críticas; corregidas en 11.0.25).
		     - Jackson 3.1.5 → 3.1.7: CVE-2026-89425, CVE-2026-89407, CVE-2026-91777, CVE-2026-68497 y CVE-2026-91776
		       (altas) y CVE-2026-83557 y CVE-2026-19032 (medias).
		     Quitar estas dos líneas cuando Spring Boot traiga esas versiones o mayores (Dependabot lo propone). -->
		<tomcat.version>11.0.26</tomcat.version>
		<jackson-bom.version>3.1.7</jackson-bom.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Sprint 5 (decisión 39): correo de respaldo por SMTP. Única dependencia nueva del sprint; apagado por defecto. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- Excel (.xlsx): solo lo usa comun.excel, en modo streaming y endurecido (regla ArchUnit) -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>${poi.version}</version>
		</dependency>

		<!-- Base de datos: MySQL en producción, H2 (modo MySQL) en desarrollo y pruebas -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.5.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<!-- Sprint 7: el modo «verificar-respaldo» corre las comprobaciones de consistencia del mismo archivo que
			     usa el operador (una sola fuente: scripts/respaldo/comprobaciones.sql). -->
			<resource>
				<directory>scripts/respaldo</directory>
				<targetPath>db/respaldo</targetPath>
				<includes>
					<include>comprobaciones.sql</include>
				</includes>
			</resource>
			<!-- Sprint 7, tanda 2: el verificador de prod compara la huella de cada trigger y función de la base con la de
			     estos archivos, empaquetados en el jar (una sola fuente: scripts/mysql/). -->
			<resource>
				<directory>scripts/mysql</directory>
				<targetPath>db/mysql</targetPath>
				<includes>
					<include>02-permisos-tablas.sql</include>
					<include>03-triggers.sql</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- ./mvnw spring-boot:run usa el perfil dev. El jar no tiene perfil por defecto:
					     hay que indicarlo (SPRING_PROFILES_ACTIVE=prod en producción). -->
					<profiles>
						<profile>dev</profile>
					</profiles>
				</configuration>
			</plugin>
			<!-- Sprint 7, tanda 3 (A06 de OWASP, decisión 102): lista de componentes (SBOM CycloneDX) de lo que va en el jar,
			     en target/classes/META-INF/sbom/application.cdx.json (versión y configuración del parent de Spring Boot; sin
			     las dependencias de prueba). Solo en el build: no es una dependencia de la aplicación. El CI la revisa con
			     OSV-Scanner (scripts/dependencias/revisar.sh) y falla con una vulnerabilidad CRÍTICA o ALTA con arreglo. -->
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
