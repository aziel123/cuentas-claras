# Cuentas Claras · arma /etc/cc/app.env y /etc/cc/respaldo.env con Secret Manager en cada arranque de la VM (sprint 8,
# tanda 3). La cuenta de servicio de la VM solo lee los secretos de su instalación.
[Unit]
Description=Cuentas Claras: secretos de la aplicación y del respaldo desde Secret Manager
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /opt/cuentas-claras/deploy/vm/cargar-secretos.sh

[Install]
WantedBy=multi-user.target
