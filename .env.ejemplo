# Copia este archivo como `.env` (en la misma carpeta) y cambia TODAS las claves.
# El archivo .env no se sube a GitHub (.gitignore).

# Administrador de MySQL (solo para crear usuarios y permisos)
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root

# Usuario de migraciones (crea y cambia tablas) y usuario de la aplicación (permisos mínimos)
CC_CLAVE_MIGRADOR=cambia-esta-clave-migrador
CC_CLAVE_APP=cambia-esta-clave-app

# Sprint 7: usuario de los respaldos diarios (solo lee la base y registra cada respaldo). Si tu base es anterior al
# sprint 7, al volver a levantar con «docker compose up» se crea solo.
CC_CLAVE_RESPALDO=cambia-esta-clave-respaldo

# Sprint 7, tanda 2: usuario de los procesos y la identidad (ingreso, claves, roles y sesiones). Solo él puede crear
# cuentas o firmar como el sistema. Si tu base es anterior al sprint 7, al volver a levantar con «docker compose up» se
# crea solo.
CC_CLAVE_SISTEMA=cambia-esta-clave-sistema

# Sprint 7: correo del responsable técnico que recibe las alertas técnicas (opcional en tu PC).
CC_OPERADOR_CORREO=


# Sella la bitácora de auditoría: 32 caracteres o más. Si la pierdes, no podrás verificar la bitácora.
AUDITORIA_CLAVE_HMAC=cambia-esta-clave-de-auditoria-de-32-caracteres-o-mas

# Sprint 8, tanda 1: nombre comercial del producto (título, cabecera, correos y mensajes). Obligatorio en prod.
CC_MARCA_NOMBRE=Cuentas Claras

# Sprint 8, tanda 1: operadores de la plataforma, "usuario:correo" separados por comas. Al arrancar se crea cada uno con un
# enlace de activación a su correo (sin clave en este archivo); con él entra a /plataforma y da de alta el colegio y su
# primera Promotoría. Quitar a alguien de la lista lo desactiva en el siguiente arranque.
CC_OPERADORES=operador:operador@tu-dominio.pe

# DEDICADA (un colegio, por defecto) o COMPARTIDA (varios colegios en una base).
CC_INSTALACION=DEDICADA

# Puerto de la aplicación en tu PC (http://localhost:8080)
PUERTO_APP=8080
